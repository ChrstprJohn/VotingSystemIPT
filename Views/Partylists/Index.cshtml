@{
    ViewData["Title"] = "Partylist Dashboard";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <div>
            <h1 class="h2">Partylist Leader Dashboard</h1>
            <p class="text-muted">Manage your slate candidates, party campaign details, and monitor statistics.</p>
        </div>
        <div class="btn-toolbar mb-2 mb-md-0">
            <button type="button" class="btn btn-sm btn-primary">
                + Add Candidate
            </button>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title text-muted">Slate Candidates</h5>
                    <h2 class="card-text fw-bold">0</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title text-muted">Partylist Status</h5>
                    <h2 class="card-text fw-bold text-success">Active</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title text-muted">Current Slate Votes</h5>
                    <h2 class="card-text fw-bold">0</h2>
                </div>
            </div>
        </div>
    </div>
</div>
