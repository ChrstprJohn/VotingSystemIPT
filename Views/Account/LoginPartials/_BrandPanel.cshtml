@model VotingSystem.Models.LoginViewModel

<section class="login-brand-panel">
    <div class="login-brand-panel__grid" aria-hidden="true"></div>

    <div class="login-brand-panel__content">
        <div class="login-logo-box">
            <img src="~/image-logo/samplogo.png" alt="QCU Logo">
        </div>

        <h1 class="login-brand-panel__title">QCU VotingSystem</h1>
        <p class="login-brand-panel__subtitle">Student Voting Portal</p>
        <p class="login-brand-panel__text">
            Cast your vote, review the candidates, and follow election results for Quezon City University.
        </p>

        <div class="login-feature">
            <div class="login-feature__head">
                <span class="login-feature__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 3 4 6v5c0 5 3.4 8.3 8 10 4.6-1.7 8-5 8-10V6l-8-3Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                        <path d="m9 12 2 2 4-4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </span>
                <span class="login-feature__title">Secure &amp; Anonymous</span>
            </div>
            <p class="login-feature__desc">Every ballot is encrypted and cannot be traced back to a voter.</p>
        </div>

        <div class="login-feature">
            <div class="login-feature__head">
                <span class="login-feature__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M5 19V10M12 19V5M19 19v-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                    </svg>
                </span>
                <span class="login-feature__title">Live Results</span>
            </div>
            <p class="login-feature__desc">Track turnout and standings as the election unfolds.</p>
        </div>
    </div>
</section>
