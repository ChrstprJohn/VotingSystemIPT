<section id="about" class="home-section border-top">
    <div class="text-center mb-5">
        <h2 class="home-section-title">About the Voting System</h2>
        <p class="home-section-subtitle">Learn how QCU's Student Council Election platform keeps voting secure, transparent, and accessible.</p>
    </div>

    <div class="admin-card">
        <div class="admin-card-body d-flex flex-column flex-md-row align-items-md-center gap-4">
            <div class="election-workspace-avatar about-hero-icon">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 11l3 3L22 4"></path>
                    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                </svg>
            </div>
            <div>
                <h3 class="about-hero-title">Student Council Elections</h3>
                <p class="about-hero-text">
                    The Council Election System is designed to modernize the election process by providing
                    a secure and organized platform for student voting. It enables students to view candidates, make
                    informed decisions, and submit their votes efficiently.
                </p>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-lg-6">
            <div class="admin-card h-100">
                <div class="admin-card-header">
                    <h4 class="admin-card-title">Our Purpose</h4>
                </div>
                <div class="admin-card-body">
                    <p class="about-text">
                        This platform was created to modernize the student election process,
                        reduce paper waste, and make voting more accessible to all students —
                        whether on campus or attending remotely.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="admin-card h-100">
                <div class="admin-card-header">
                    <h4 class="admin-card-title">Election Integrity</h4>
                </div>
                <div class="admin-card-body">
                    <p class="about-text mb-3">
                        Each student is allowed one vote per election to ensure fairness.
                        Votes are securely recorded and results are only released after
                        the voting period officially closes.
                    </p>
                    <div class="alert alert-light border small text-muted mb-0">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1 text-primary">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        </svg>
                        <strong>One Student, One Vote:</strong> Duplicate ballots are automatically rejected by the system.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="admin-card mt-4">
        <div class="admin-card-header">
            <h4 class="admin-card-title">How It Works</h4>
        </div>
        <div class="admin-card-body">
            <div class="about-steps">
                <div class="about-step">
                    <span class="badge bg-dark text-white rounded-pill about-step-number">1</span>
                    <div>
                        <div class="about-step-title">Log In</div>
                        <div class="about-step-text">Sign in using your official student account credentials.</div>
                    </div>
                </div>
                <div class="about-step">
                    <span class="badge bg-dark text-white rounded-pill about-step-number">2</span>
                    <div>
                        <div class="about-step-title">Review Candidates</div>
                        <div class="about-step-text">View the list of candidates and their platforms for each contested position.</div>
                    </div>
                </div>
                <div class="about-step">
                    <span class="badge bg-dark text-white rounded-pill about-step-number">3</span>
                    <div>
                        <div class="about-step-title">Cast Your Vote</div>
                        <div class="about-step-text">Select your preferred candidate or partylist for each position.</div>
                    </div>
                </div>
                <div class="about-step">
                    <span class="badge bg-dark text-white rounded-pill about-step-number">4</span>
                    <div>
                        <div class="about-step-title">Submit Ballot</div>
                        <div class="about-step-text">Confirm and submit your ballot before the voting period officially ends.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="admin-card mt-4">
        <div class="admin-card-header">
            <h4 class="admin-card-title">Need Help?</h4>
        </div>
        <div class="admin-card-body d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
            <p class="about-text mb-0">
                If you experience any issues while voting, please contact the Student Affairs Office.
            </p>
            <a href="mailto:qcu.example.email@edu.qcu.ph" class="btn btn-sm btn-dark d-inline-flex align-items-center gap-1 px-3 flex-shrink-0">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                    <polyline points="22 6 12 13 2 6"></polyline>
                </svg>
                <span>Email Support</span>
            </a>
        </div>
    </div>
</section>
