@{
    ViewData["Title"] = "About Page";
}

<link rel="stylesheet" href="~/css/pages/about.css" />

<div class="banner-container">
    <img src="~/image-logo/qcu-image-sample.jpg" alt="QCU Banner" class="banner-img" />
</div>

<div class="about-page animate-section">
    <img src="~/image-logo/image1-sample.jpg" alt="QCU Logo" />
    <div>
        <h1>Student Council Elections</h1>
        <p>
            The Council Election System is designed to modernized the election process by providing
            a secure and organized platform for student voting. It enables students to view candidates, make
            informed decisions, and submit their votes efficiently.
        </p>
    </div>
</div>

<div class="purpose-section animate-section">
    <h2>Our Purpose</h2>
    <p>
        This plaform was created to modernized the student election
        process, reduce paper waste, and make voting more accessible to
        all students - whether on campus or attending remotely. It provides
        a convenient and organized way for students to cast their votes securely
        and efficiently. By using a digital voting system, the platform also
        promotes a fair, transparent, and reliable election experience for the
        entire student community.
    </p>
</div>

<div class="how-it-works-section animate-section">
    <h2>How It Works</h2>
    <div class="marquee-wrapper">
        <div class="marquee-track">
            <div class="marquee-item">
                <img src="~/image-logo/img4.png" alt="Step 1" />
                <span class="marquee-number">1</span>
            </div>
            <div class="marquee-item">
                <img src="~/image-logo/img3.png" alt="Step 2" />
                <span class="marquee-number">2</span>
            </div>
            <div class="marquee-item">
                <img src="~/image-logo/img2.png" alt="Step 3" />
                <span class="marquee-number">3</span>
            </div>
            <div class="marquee-item">
                <img src="~/image-logo/img1.png" alt="Step 4" />
                <span class="marquee-number">4</span>
            </div>
            <!-- duplicate set - kailangan EXACT copy para seamless -->
            <div class="marquee-item">
                <img src="~/image-logo/img4.png" alt="Step 1" />
                <span class="marquee-number">1</span>
            </div>
            <div class="marquee-item">
                <img src="~/image-logo/img3.png" alt="Step 2" />
                <span class="marquee-number">2</span>
            </div>
            <div class="marquee-item">
                <img src="~/image-logo/img2.png" alt="Step 3" />
                <span class="marquee-number">3</span>
            </div>
            <div class="marquee-item">
                <img src="~/image-logo/img1.png" alt="Step 4" />
                <span class="marquee-number">4</span>
            </div>
        </div>
    </div>
</div>

<div class="integrity-section">
    <h2>Election Integrity</h2>
    <p>
        Each student is allowed one vote per election to ensure fairness.
        Votes are securely recorded and results are only released after
        the voting period officially closes. The system helps prevent unauthorized
        voting and protects the accuracy of every submitted ballot. These measures
        promote transparency, accountability, and trust throughout the election
        process.
    </p>
</div>

<div class="help-section">
    <h2>Need Help?</h2>
    <p>
        If you experience any issues while voting, please contact the
        Student Affairs Office or email
        <a href="mailto:qcu.example.email@edu.qcu.ph">qcu.example.email@edu.qcu.ph</a>.
        Our support team is available to assist you with any voting-related concerns
        or technical difficulties. Please provide a clear description of the issue
        so we can help resolve it as quickly as possible.
    </p>
</div>


