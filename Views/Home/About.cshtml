@{
    ViewData["Title"] = "About Page";
}

<link rel="stylesheet" href="~/css/pages/about.css" />

<img src="~/image-logo/qcu-image-sample.jpg" alt="QCU Banner" class="banner-img" />

<div class="about-page">
    <img src="~/image-logo/image1-sample.jpg" alt="QCU Logo" />
    <div>
        <h1>Student Council Elections</h1>
        <p>
            The Council Election System is designed to modernized the election process by providing
            a secure and organized platform for student voting. It enables students to view candidates, make
            informed decisions, and submit their votes efficiently.
        </p>
    </div>
</div>

<div>
    <h2>Our Purpose</h2>
    <p>
        This platform was created to modernize the student election process,
        reduce paper waste, and make voting more accessible to all students —
        whether on campus or attending remotely.
    </p>

    <h2>How It Works</h2>
    <ul>
        <li>Log in using your official student account.</li>
        <li>View the list of candidates and their platforms.</li>
        <li>Cast your vote for each position.</li>
        <li>Submit your ballot before the voting period ends.</li>
    </ul>

    <h2>Election Integrity</h2>
    <p>
        Each student is allowed one vote per election to ensure fairness.
        Votes are securely recorded and results are only released after
        the voting period officially closes.
    </p>

    <h2>Need Help?</h2>
    <p>
        If you experience any issues while voting, please contact the
        Student Affairs Office or email
        <a href="mailto:qcu.example.email@edu.qcu.ph">qcu.example.email@edu.qcu.ph</a>.
    </p>
</div>


