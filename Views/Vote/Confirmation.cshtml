@{
    ViewData["Title"] = "Ballot submitted";
    Layout = "_LayoutAuth";
    var title = ViewData["ElectionTitle"] as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/vote.css" asp-append-version="true" />
}

<div class="ballot-shell">
    <div class="ballot-card ballot-card--center">
        <div class="ballot-success">✓</div>
        <h1>Your ballot has been submitted</h1>
        <p>Thank you for voting in <strong>@title</strong>. Your participation has been recorded.
           Your individual choices remain secret.</p>
        <a class="vote-btn" href="/vote">Back to elections</a>
    </div>
</div>
