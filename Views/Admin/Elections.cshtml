@model List<VotingSystem.Models.ViewModels.ElectionListItem>
@{
    ViewData["Title"] = "Elections";

    string StatusBadge(VotingSystem.Models.Domain.PublicElectionStatus s) => s switch
    {
        VotingSystem.Models.Domain.PublicElectionStatus.Ongoing => "active",
        VotingSystem.Models.Domain.PublicElectionStatus.Upcoming => "info",
        VotingSystem.Models.Domain.PublicElectionStatus.Draft => "warning",
        _ => "inactive"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin.css" asp-append-version="true" />
}

@section TopbarActions {
    <button type="button" class="btn btn-sm btn-dark d-inline-flex align-items-center gap-1 px-3 py-1"
            data-bs-toggle="modal" data-bs-target="#createElectionModal">
        <span>Create election</span>
    </button>
}

<partial name="_Flash" />

<div class="admin-card">
    <div class="admin-card-header d-flex justify-content-between align-items-center">
        <span class="admin-card-title">All elections</span>
        <input type="text" class="voters-search-input" id="electionsSearchInput" placeholder="Search title or description..." style="max-width: 320px;" />
    </div>
    <div class="admin-table-container">
        <table class="admin-table" id="electionsTable">
            <thead>
                <tr>
                    <th>Title &amp; scope</th>
                    <th>Schedule</th>
                    <th>Status</th>
                    <th>Ballot setup</th>
                    <th style="text-align:right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No elections yet.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <span class="voter-name-main text-dark">@item.Election.Title</span>
                            <span class="voter-email-sub">@item.Election.Description</span>
                        </td>
                        <td class="small text-muted">
                            @item.Election.StartAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")<br />
                            to @item.Election.EndAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                        </td>
                        <td>
                            <span class="status-badge-dot @StatusBadge(item.Status)">
                                <span class="dot-indicator @StatusBadge(item.Status)"></span>
                                @item.Status
                            </span>
                        </td>
                        <td class="small">
                            <span class="badge bg-light text-dark border">@item.PositionCount positions</span>
                            <span class="badge bg-light text-dark border">@item.PartylistCount party lists</span>
                            <span class="badge bg-light text-dark border">@item.CandidateCount candidates</span>
                        </td>
                        <td style="text-align:right;">
                            <a class="btn btn-xs btn-dark" asp-action="ElectionSetup" asp-route-id="@item.Election.Id">Manage</a>
                            @if (item.Status is VotingSystem.Models.Domain.PublicElectionStatus.Ongoing
                                or VotingSystem.Models.Domain.PublicElectionStatus.Closed)
                            {
                                <a class="btn btn-xs btn-outline-secondary" asp-action="Reports" asp-route-id="@item.Election.Id">Reports</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="createElectionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="CreateElection" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Create election</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label small fw-semibold">Election name <span class="text-danger">*</span></label>
                    <input type="text" name="title" class="form-control" required
                           placeholder="e.g. Supreme Student Council General Elections 2026-2027" />
                    <p class="text-muted small mt-2 mb-0">
                        A draft is created and you continue with the step-by-step setup.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-light border" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-dark px-3">Create &amp; continue</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('electionsSearchInput')?.addEventListener('input', function () {
            var q = this.value.toLowerCase().trim();
            document.querySelectorAll('#electionsTable tbody tr').forEach(function (row) {
                row.style.display = !q || row.innerText.toLowerCase().includes(q) ? '' : 'none';
            });
        });
    </script>
}
