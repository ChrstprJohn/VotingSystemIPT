@{
    ViewData["Title"] = "Elections";
    ViewData["IsFullWidth"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin.css" asp-append-version="true" />
}

@section TopbarActions {
    <button type="button" class="btn btn-sm btn-dark d-inline-flex align-items-center gap-1 px-3 py-1" data-bs-toggle="modal" data-bs-target="#createElectionModal">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        <span>Create Election</span>
    </button>
}

<div class="election-page-body bg-white">
    <!-- Metrics Row -->
    <partial name="ElectionsPartials/_ElectionsMetrics" />

    <!-- Main Table Card -->
    <div class="admin-card mb-0">
        <partial name="ElectionsPartials/_ElectionsToolbar" />
        <partial name="ElectionsPartials/_ElectionsTable" />
    </div>
</div>

<!-- Modals -->
<partial name="ElectionsPartials/_CreateElectionModal" />
<partial name="ElectionsPartials/_AddPositionModal" />

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Elements: Wizard Panes, Steppers, and Footers
            const modalEl = document.getElementById('createElectionModal');
            const pane1 = document.getElementById('wizardPane1');
            const pane2 = document.getElementById('wizardPane2');
            const footerStep1 = document.getElementById('wizardFooterStep1');
            const footerStep2 = document.getElementById('wizardFooterStep2');
            const stepInd1 = document.getElementById('wizardStepIndicator1');
            const stepInd2 = document.getElementById('wizardStepIndicator2');
            const stepLine1 = document.getElementById('wizardStepLine1');

            // Wizard Inputs
            const electionTitleInput = document.getElementById('electionTitle');
            const electionSchoolYearInput = document.getElementById('electionSchoolYear');
            const electionScopeInput = document.getElementById('electionScope');
            const electionDescInput = document.getElementById('electionDesc');
            const startDateInput = document.getElementById('startDate');
            const startTimeInput = document.getElementById('startTime');
            const endDateInput = document.getElementById('endDate');
            const endTimeInput = document.getElementById('endTime');

            // Buttons & Containers
            const btnNext = document.getElementById('btnWizardNext');
            const btnBack = document.getElementById('btnWizardBack');
            const btnSubmit = document.getElementById('btnWizardSubmit');
            const cardsContainer = document.getElementById('positionsCardsContainer');
            const btnAddCard = document.getElementById('btnAddPositionCard');
            const posCountDisplay = document.getElementById('posCountDisplay');
            const seatCountDisplay = document.getElementById('seatCountDisplay');

            // Initial Default Standard Positions
            const initialPositions = [
                { title: 'President', winners: 1, maxParty: 1 },
                { title: 'Vice President', winners: 1, maxParty: 1 },
                { title: 'Secretary General', winners: 1, maxParty: 1 },
                { title: 'Treasurer', winners: 1, maxParty: 1 },
                { title: 'Auditor', winners: 1, maxParty: 1 },
                { title: 'Councilors', winners: 6, maxParty: 6 }
            ];

            function renderInitialPositions() {
                if (!cardsContainer) return;
                cardsContainer.innerHTML = '';
                initialPositions.forEach((pos, idx) => {
                    const row = createCardElement(idx + 1, pos.title, pos.winners, pos.maxParty);
                    cardsContainer.appendChild(row);
                });
                updateCounters();
            }

            function updateCounters() {
                if (!cardsContainer) return;
                const rows = cardsContainer.querySelectorAll('.position-item');
                let totalSeats = 0;
                rows.forEach(row => {
                    const winnerInput = row.querySelector('.pos-winners-input');
                    if (winnerInput) {
                        totalSeats += parseInt(winnerInput.value) || 0;
                    }
                });
                if (posCountDisplay) posCountDisplay.textContent = rows.length;
                if (seatCountDisplay) seatCountDisplay.textContent = totalSeats;
            }

            function createCardElement(index, title, winners, maxParty) {
                const row = document.createElement('div');
                row.className = 'position-item row g-2 align-items-center';

                row.innerHTML = `
                    <div class="col">
                        <input type="text" class="form-control pos-title-input" value="${escapeHtml(title)}" placeholder="Position title (e.g. President)" required />
                    </div>
                    <div class="col-auto" style="width: 85px;">
                        <input type="number" class="form-control text-center pos-winners-input" value="${winners}" min="1" max="50" title="Seats" required />
                    </div>
                    <div class="col-auto" style="width: 85px;">
                        <input type="number" class="form-control text-center pos-party-input" value="${maxParty}" min="1" max="50" title="Max per partylist" required />
                    </div>
                    <div class="col-auto" style="width: 32px;">
                        <button type="button" class="btn btn-link text-muted p-0 remove-pos-btn d-flex align-items-center justify-content-center w-100" title="Remove position" style="height: 38px;">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                        </button>
                    </div>
                `;

                return row;
            }

            // Step Navigation Functions
            function goToStep(step) {
                if (step === 2) {
                    // Validate Step 1
                    const title = (electionTitleInput?.value || '').trim();
                    if (!title) {
                        electionTitleInput.classList.add('is-invalid');
                        electionTitleInput.focus();
                        return false;
                    }
                    electionTitleInput.classList.remove('is-invalid');

                    // Check date/time
                    if (startDateInput && !startDateInput.value) {
                        startDateInput.classList.add('is-invalid');
                        startDateInput.focus();
                        return false;
                    }
                    if (startDateInput) startDateInput.classList.remove('is-invalid');

                    if (endDateInput && !endDateInput.value) {
                        endDateInput.classList.add('is-invalid');
                        endDateInput.focus();
                        return false;
                    }
                    if (endDateInput) endDateInput.classList.remove('is-invalid');

                    if (startDateInput && endDateInput && startDateInput.value && endDateInput.value) {
                        const start = new Date(`${startDateInput.value}T${startTimeInput?.value || '00:00'}`);
                        const end = new Date(`${endDateInput.value}T${endTimeInput?.value || '23:59'}`);
                        if (end <= start) {
                            alert('End schedule must be after start schedule.');
                            endDateInput.focus();
                            return false;
                        }
                    }

                    // Switch view to Step 2
                    pane1.style.display = 'none';
                    footerStep1.style.setProperty('display', 'none', 'important');
                    pane2.style.display = 'block';
                    footerStep2.style.setProperty('display', 'flex', 'important');

                    // Update Stepper Indicators
                    stepInd1.classList.remove('active');
                    stepInd1.classList.add('completed');
                    stepLine1.classList.add('completed');
                    stepInd2.classList.add('active');

                    updateCounters();
                } else {
                    // Switch view back to Step 1
                    pane2.style.display = 'none';
                    footerStep2.style.setProperty('display', 'none', 'important');
                    pane1.style.display = 'block';
                    footerStep1.style.setProperty('display', 'flex', 'important');

                    // Update Stepper Indicators
                    stepInd2.classList.remove('active');
                    stepLine1.classList.remove('completed');
                    stepInd1.classList.remove('completed');
                    stepInd1.classList.add('active');
                }
                return true;
            }

            if (btnNext) btnNext.addEventListener('click', () => goToStep(2));
            if (btnBack) btnBack.addEventListener('click', () => goToStep(1));

            // Reset Wizard when modal is closed
            if (modalEl) {
                modalEl.addEventListener('hidden.bs.modal', function () {
                    goToStep(1);
                    if (electionTitleInput) {
                        electionTitleInput.classList.remove('is-invalid');
                    }
                    if (startDateInput) startDateInput.classList.remove('is-invalid');
                    if (endDateInput) endDateInput.classList.remove('is-invalid');
                });
            }

            if (electionTitleInput) {
                electionTitleInput.addEventListener('input', function () {
                    if (this.value.trim()) {
                        this.classList.remove('is-invalid');
                    }
                });
            }

            [startDateInput, endDateInput].forEach(inp => {
                if (inp) {
                    inp.addEventListener('input', function () {
                        if (this.value) {
                            this.classList.remove('is-invalid');
                        }
                    });
                }
            });

            // Position Add & Remove Events
            if (btnAddCard && cardsContainer) {
                btnAddCard.addEventListener('click', function () {
                    const rowCount = cardsContainer.querySelectorAll('.position-item').length + 1;
                    const newRow = createCardElement(rowCount, '', 1, 1);
                    cardsContainer.appendChild(newRow);
                    updateCounters();
                    const input = newRow.querySelector('.pos-title-input');
                    if (input) input.focus();
                });
            }

            if (cardsContainer) {
                cardsContainer.addEventListener('click', function (e) {
                    const removeBtn = e.target.closest('.remove-pos-btn');
                    if (removeBtn) {
                        const row = removeBtn.closest('.position-item');
                        if (cardsContainer.querySelectorAll('.position-item').length > 1) {
                            row.remove();
                            updateCounters();
                        } else {
                            alert('At least one position is required for an election.');
                        }
                    }
                });

                cardsContainer.addEventListener('input', function (e) {
                    if (e.target.classList.contains('pos-winners-input')) {
                        updateCounters();
                    }
                });
            }

            // Create Election Submission & Dynamic Table Addition
            if (btnSubmit) {
                btnSubmit.addEventListener('click', function () {
                    // Check that all positions have titles
                    const titleInputs = cardsContainer ? cardsContainer.querySelectorAll('.pos-title-input') : [];
                    let hasEmptyTitle = false;
                    titleInputs.forEach(inp => {
                        if (!inp.value.trim()) {
                            hasEmptyTitle = true;
                            inp.classList.add('is-invalid');
                        } else {
                            inp.classList.remove('is-invalid');
                        }
                    });

                    if (hasEmptyTitle) {
                        alert('Please provide a title for all configured positions.');
                        return;
                    }

                    const title = (electionTitleInput?.value || 'New Election').trim();
                    const sy = electionSchoolYearInput?.value || '2026-2027';
                    const scope = (electionScopeInput?.value || 'University-Wide Campus').trim();
                    const scopeSubtitle = `A.Y. ${sy} &bull; ${escapeHtml(scope)}`;
                    const sDate = startDateInput?.value;
                    const sTime = startTimeInput?.value;
                    const eDate = endDateInput?.value;
                    const eTime = endTimeInput?.value;

                    const sFormatted = sDate
                        ? new Date(`${sDate}T${sTime || '00:00'}`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
                        : 'TBD';
                    const eFormatted = eDate
                        ? new Date(`${eDate}T${eTime || '23:59'}`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
                        : 'TBD';
                    const sTimeDisplay = sTime ? ` &bull; ${sTime}` : '';
                    const eTimeDisplay = eTime ? ` &bull; ${eTime}` : '';
                    const posCount = titleInputs.length;

                    // Dynamically prepend new row to Elections Table
                    const electionsTbody = document.querySelector('#electionsTable tbody');
                    if (electionsTbody) {
                        const newTr = document.createElement('tr');
                        newTr.className = 'table-success-subtle-transition';
                        newTr.innerHTML = `
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="status-indicator-pulse prep"></span>
                                    <div>
                                        <a href="/Admin/ElectionDetail?id=1&tab=overview" class="voter-name-main text-dark text-decoration-none hover-underline">${escapeHtml(title)}</a>
                                        <span class="voter-email-sub">${scopeSubtitle}</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex flex-column text-nowrap">
                                    <span class="text-dark small fw-medium">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1 text-muted">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <polyline points="12 6 12 12 16 14"></polyline>
                                        </svg>
                                        ${sFormatted}${sTimeDisplay}
                                    </span>
                                    <span class="text-muted small">
                                        to ${eFormatted}${eTimeDisplay}
                                    </span>
                                </div>
                            </td>
                            <td>
                                <span class="status-badge-dot warning">
                                    <span class="dot-indicator warning"></span>
                                    Preparation
                                </span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-light text-dark border small fw-normal">${posCount} Positions</span>
                                    <span class="badge bg-light text-muted border small fw-normal">0 Candidates</span>
                                </div>
                            </td>
                            <td style="text-align: right;">
                                <div class="dropdown d-inline-block">
                                    <button type="button" class="btn-action-more" data-bs-toggle="dropdown" data-bs-boundary="viewport" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false" title="Actions" aria-label="Election actions">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="12" cy="12" r="1.5"></circle>
                                            <circle cx="19" cy="12" r="1.5"></circle>
                                            <circle cx="5" cy="12" r="1.5"></circle>
                                        </svg>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-actions shadow-sm">
                                        <li><h6 class="dropdown-header">Manage</h6></li>
                                        <li>
                                            <a href="/Admin/ElectionDetail?id=1&tab=overview" class="dropdown-item">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <rect x="3" y="3" width="7" height="7"></rect>
                                                    <rect x="14" y="3" width="7" height="7"></rect>
                                                    <rect x="14" y="14" width="7" height="7"></rect>
                                                    <rect x="3" y="14" width="7" height="7"></rect>
                                                </svg>
                                                <span>Overview &amp; Stats</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a href="/Admin/ElectionDetail?id=1&tab=positions" class="dropdown-item">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                                    <circle cx="8.5" cy="7" r="4"></circle>
                                                    <line x1="20" y1="8" x2="20" y2="14"></line>
                                                    <line x1="23" y1="11" x2="17" y2="11"></line>
                                                </svg>
                                                <span>Positions &amp; Quotas</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a href="/Admin/ElectionDetail?id=1&tab=partylists" class="dropdown-item">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path>
                                                    <line x1="4" y1="22" x2="4" y2="15"></line>
                                                </svg>
                                                <span>Partylists</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a href="/Admin/ElectionDetail?id=1&tab=candidates" class="dropdown-item">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                                    <circle cx="9" cy="7" r="4"></circle>
                                                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                                </svg>
                                                <span>Candidates</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a href="/Admin/ElectionDetail?id=1&tab=settings" class="dropdown-item">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <circle cx="12" cy="12" r="3"></circle>
                                                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                                                </svg>
                                                <span>Settings</span>
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <button type="button" class="dropdown-item text-danger btn-delete-election">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="3 6 5 6 21 6"></polyline>
                                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                                    <line x1="10" y1="11" x2="10" y2="17"></line>
                                                    <line x1="14" y1="11" x2="14" y2="17"></line>
                                                </svg>
                                                <span>Delete Election</span>
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        `;
                        electionsTbody.insertBefore(newTr, electionsTbody.firstChild);
                    }

                    // Close modal cleanly
                    const bsModal = bootstrap.Modal.getInstance(modalEl);
                    if (bsModal) {
                        bsModal.hide();
                    } else {
                        modalEl.querySelector('[data-bs-dismiss="modal"]')?.click();
                    }

                    // Reset form fields
                    if (electionTitleInput) electionTitleInput.value = '';
                    if (electionScopeInput) electionScopeInput.value = '';
                    if (electionDescInput) electionDescInput.value = '';
                    if (startDateInput) { startDateInput.value = ''; startDateInput.classList.remove('is-invalid'); }
                    if (startTimeInput) startTimeInput.value = '';
                    if (endDateInput) { endDateInput.value = ''; endDateInput.classList.remove('is-invalid'); }
                    if (endTimeInput) endTimeInput.value = '';
                    renderInitialPositions();
                });
            }

            function escapeHtml(text) {
                const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
                return (text || '').replace(/[&<>"']/g, function (m) { return map[m]; });
            }

            // Client-side Search Filtering for Elections Table
            const searchInput = document.getElementById('electionsSearchInput');
            const statusFilter = document.getElementById('electionStatusFilter');

            function filterTable() {
                const query = (searchInput?.value || '').toLowerCase().trim();
                const selectedStatus = (statusFilter?.value || 'all').toLowerCase();
                const currentRows = document.querySelectorAll('#electionsTable tbody tr');

                currentRows.forEach(row => {
                    const text = row.innerText.toLowerCase();
                    const statusText = row.querySelector('td:nth-child(3)')?.innerText.toLowerCase() || '';

                    const matchesQuery = !query || text.includes(query);
                    const matchesStatus = selectedStatus === 'all' || statusText.includes(selectedStatus);

                    row.style.display = matchesQuery && matchesStatus ? '' : 'none';
                });
            }

            if (searchInput) searchInput.addEventListener('input', filterTable);
            if (statusFilter) statusFilter.addEventListener('change', filterTable);

            // Populate initial standard positions into cards
            renderInitialPositions();
        });
    </script>
}

