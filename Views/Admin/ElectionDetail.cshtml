@{
    var electionId = ViewData["ElectionId"]?.ToString() ?? "1";
    var activeTab = ViewData["ActiveTab"]?.ToString() ?? "overview";

    // Election Metadata dictionary for demo/mock state
    var electionTitle = electionId switch {
        "2" => "College of Computing Studies (CCS) Council",
        "3" => "College of Engineering Student Assembly",
        "4" => "University Student Council Special Elections 2025",
        _ => "Supreme Student Council General Elections"
    };

    var electionScope = electionId switch {
        "2" => "1st Semester 2026–2027 • Local College Election",
        "3" => "1st Semester 2026–2027 • Local College Election",
        "4" => "A.Y. 2025–2026 • Special Interim Term",
        _ => "A.Y. 2026–2027 • University-Wide Campus"
    };

    var electionSchedule = electionId switch {
        "2" => "Nov 02, 2026, 09:00 AM – Nov 03, 2026, 04:00 PM",
        "3" => "Nov 10, 2026, 08:00 AM – Nov 11, 2026, 05:00 PM",
        "4" => "Dec 01, 2025, 08:00 AM – Dec 02, 2025, 05:00 PM",
        _ => "Oct 15, 2026, 08:00 AM – Oct 16, 2026, 05:00 PM"
    };

    var electionStatus = electionId switch {
        "2" => "Preparation",
        "3" => "Upcoming",
        "4" => "Completed",
        _ => "Ongoing"
    };

    var statusClass = electionId switch {
        "2" => "warning",
        "3" => "info",
        "4" => "completed",
        _ => "active"
    };

    ViewData["Title"] = electionTitle;
    ViewData["ActivePage"] = "Elections";
    ViewData["BreadcrumbParent"] = "Elections";
    ViewData["BreadcrumbParentUrl"] = Url.Action("Elections", "Admin");
    ViewData["IsFullWidth"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin.css" asp-append-version="true" />
}

@section TopbarActions {
    <div class="d-flex align-items-center gap-2">
        <a asp-controller="Admin" asp-action="Elections" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1.5 px-3 py-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
            <span>Back to Elections</span>
        </a>
        <a asp-controller="Home" asp-action="Index" target="_blank" class="btn btn-sm btn-dark d-inline-flex align-items-center gap-1.5 px-3 py-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
            </svg>
            <span>Preview Ballot</span>
        </a>
    </div>
}

<!-- Election Detail Layout: Left Sidebar Nav + Content -->
<div class="election-detail-layout">
    <!-- Left Sidebar Navigation -->
    <div class="election-detail-sidebar">
        <ul class="nav flex-column election-side-nav" id="electionDetailTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "overview" ? "active" : "")" id="tab-overview" data-bs-toggle="tab" data-bs-target="#pane-overview" type="button" role="tab" data-tab-key="overview">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7"></rect>
                        <rect x="14" y="3" width="7" height="7"></rect>
                        <rect x="14" y="14" width="7" height="7"></rect>
                        <rect x="3" y="14" width="7" height="7"></rect>
                    </svg>
                    <span>Overview &amp; Stats</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "positions" ? "active" : "")" id="tab-positions" data-bs-toggle="tab" data-bs-target="#pane-positions" type="button" role="tab" data-tab-key="positions">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="8.5" cy="7" r="4"></circle>
                        <line x1="20" y1="8" x2="20" y2="14"></line>
                        <line x1="23" y1="11" x2="17" y2="11"></line>
                    </svg>
                    <span>Positions &amp; Quotas</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "partylists" ? "active" : "")" id="tab-partylists" data-bs-toggle="tab" data-bs-target="#pane-partylists" type="button" role="tab" data-tab-key="partylists">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path>
                        <line x1="4" y1="22" x2="4" y2="15"></line>
                    </svg>
                    <span>Partylists</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "candidates" ? "active" : "")" id="tab-candidates" data-bs-toggle="tab" data-bs-target="#pane-candidates" type="button" role="tab" data-tab-key="candidates">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                    <span>Candidates</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "settings" ? "active" : "")" id="tab-settings" data-bs-toggle="tab" data-bs-target="#pane-settings" type="button" role="tab" data-tab-key="settings">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="3"></circle>
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                    </svg>
                    <span>Settings</span>
                </button>
            </li>
        </ul>
    </div>

    <!-- Main Content Area -->
    <div class="election-detail-content bg-white">
            <div class="tab-content" id="electionDetailTabsContent">
                <!-- ============================================== -->
                <!-- TAB 1: OVERVIEW & STATS -->
                <!-- ============================================== -->
                <div class="tab-pane fade @(activeTab == "overview" ? "show active" : "")" id="pane-overview" role="tabpanel">
                    <!-- Live Status Banner -->
                    @if (electionStatus == "Ongoing")
                    {
                        <div class="p-3 mb-4 rounded border bg-success-subtle border-success-subtle d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="dot-indicator active"></span>
                                <span class="fw-semibold text-success-emphasis">Voting is currently LIVE and accepting ballots</span>
                            </div>
                            <span class="small text-muted">Closes Oct 16, 2026 at 05:00 PM</span>
                        </div>
                    }
                    else if (electionStatus == "Preparation")
                    {
                        <div class="p-3 mb-4 rounded border bg-warning-subtle border-warning-subtle d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="dot-indicator warning"></span>
                                <span class="fw-semibold text-warning-emphasis">Election setup is in PREPARATION mode</span>
                            </div>
                            <span class="small text-muted">Awaiting position quota confirmation and candidate filings</span>
                        </div>
                    }
                    else if (electionStatus == "Upcoming")
                    {
                        <div class="p-3 mb-4 rounded border bg-info-subtle border-info-subtle d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="dot-indicator info"></span>
                                <span class="fw-semibold text-info-emphasis">Scheduled to start automatically on schedule</span>
                            </div>
                            <span class="small text-muted">Ballots will be unlocked for verified voters on start date</span>
                        </div>
                    }
                    else
                    {
                        <div class="p-3 mb-4 rounded border bg-light border-secondary-subtle d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="dot-indicator completed"></span>
                                <span class="fw-semibold text-dark">Election concluded and certified</span>
                            </div>
                            <span class="small text-muted">Final audit report archived</span>
                        </div>
                    }

                    <!-- Mini stats grid -->
                    <div class="row g-3 mb-4">
                        <div class="col-sm-6 col-lg-3">
                            <div class="p-3.5 bg-light rounded border h-100">
                                <div class="text-muted small fw-medium mb-1">Total Turnout</div>
                                <div class="fs-4 fw-bold text-dark">68.0%</div>
                                <div class="small text-muted mt-1">3,278 of 4,820 voted</div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-lg-3">
                            <div class="p-3.5 bg-light rounded border h-100">
                                <div class="text-muted small fw-medium mb-1">Contested Positions</div>
                                <div class="fs-4 fw-bold text-dark">10</div>
                                <div class="small text-muted mt-1">All positions active</div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-lg-3">
                            <div class="p-3.5 bg-light rounded border h-100">
                                <div class="text-muted small fw-medium mb-1">Fielded Candidates</div>
                                <div class="fs-4 fw-bold text-dark">24</div>
                                <div class="small text-muted mt-1">Across 2 Partylists</div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-lg-3">
                            <div class="p-3.5 bg-light rounded border h-100">
                                <div class="text-muted small fw-medium mb-1">Remaining Time</div>
                                <div class="fs-4 fw-bold text-dark">14h 22m</div>
                                <div class="small text-muted mt-1">Live countdown</div>
                            </div>
                        </div>
                    </div>

                    <!-- Progress Bar -->
                    <div class="card border mb-4">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="small fw-semibold text-dark">Voter Participation Progress</span>
                                <span class="small fw-bold text-dark">3,278 / 4,820 Ballots Cast (68.0%)</span>
                            </div>
                            <div class="progress" style="height: 12px; border-radius: 6px;">
                                <div class="progress-bar bg-dark" role="progressbar" style="width: 68%;" aria-valuenow="68" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2 small text-muted">
                                <span>Quorum target: 50% (Achieved)</span>
                                <span>1,542 Registered Voters Remaining</span>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Navigation Links inside Overview -->
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="p-3 border rounded h-100 d-flex flex-column justify-content-between bg-white">
                                <div>
                                    <h6 class="fw-bold text-dark mb-1">Positions & Quotas</h6>
                                    <p class="small text-muted mb-3">Review seat allocations and maximum candidates per party.</p>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-secondary w-100" onclick="switchTab('positions')">
                                    Manage Positions &rarr;
                                </button>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 border rounded h-100 d-flex flex-column justify-content-between bg-white">
                                <div>
                                    <h6 class="fw-bold text-dark mb-1">Partylists</h6>
                                    <p class="small text-muted mb-3">Inspect registered coalitions, alliances, and slates.</p>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-secondary w-100" onclick="switchTab('partylists')">
                                    View Partylists &rarr;
                                </button>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 border rounded h-100 d-flex flex-column justify-content-between bg-white">
                                <div>
                                    <h6 class="fw-bold text-dark mb-1">Candidate Roster</h6>
                                    <p class="small text-muted mb-3">Verify student credentials and official ballot candidacy.</p>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-secondary w-100" onclick="switchTab('candidates')">
                                    Manage Candidates &rarr;
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ============================================== -->
                <!-- TAB 2: POSITIONS & QUOTAS -->
                <!-- ============================================== -->
                <div class="tab-pane fade @(activeTab == "positions" ? "show active" : "")" id="pane-positions" role="tabpanel">
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-3">
                        <div>
                            <h6 class="fw-bold text-dark mb-1">Contested Positions &amp; Quotas</h6>
                            <p class="text-muted small mb-0">Set how many candidates can win and the seat limit per partylist.</p>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                                </svg>
                                <span>Load Template</span>
                            </button>
                            <button type="button" class="btn btn-sm btn-dark d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#addPositionModal">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                </svg>
                                <span>Add Position</span>
                            </button>
                        </div>
                    </div>

                    <!-- Positions Table -->
                    <div class="table-responsive border rounded">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 50px;">#</th>
                                    <th>Position Title</th>
                                    <th style="width: 150px;">Winners (Seats)</th>
                                    <th style="width: 180px;">Max Per Partylist</th>
                                    <th style="width: 120px;">Abstain</th>
                                    <th style="width: 140px;">Fielded</th>
                                    <th style="width: 100px; text-align: right;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="text-muted fw-bold">1</td>
                                    <td>
                                        <span class="fw-semibold text-dark">President</span>
                                        <span class="d-block text-muted small">Single-seat executive</span>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">1 Winner</span></td>
                                    <td><span class="badge bg-light text-dark border">Max 1 per party</span></td>
                                    <td><span class="text-success fw-medium">Allowed</span></td>
                                    <td><span class="text-dark fw-semibold">2 Candidates</span></td>
                                    <td style="text-align: right;">
                                        <button type="button" class="btn btn-xs btn-outline-secondary py-0.5 px-1.5 me-1">Edit</button>
                                        <button type="button" class="btn btn-xs btn-outline-danger py-0.5 px-1.5">Del</button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-muted fw-bold">2</td>
                                    <td>
                                        <span class="fw-semibold text-dark">Vice President</span>
                                        <span class="d-block text-muted small">Single-seat executive</span>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">1 Winner</span></td>
                                    <td><span class="badge bg-light text-dark border">Max 1 per party</span></td>
                                    <td><span class="text-success fw-medium">Allowed</span></td>
                                    <td><span class="text-dark fw-semibold">2 Candidates</span></td>
                                    <td style="text-align: right;">
                                        <button type="button" class="btn btn-xs btn-outline-secondary py-0.5 px-1.5 me-1">Edit</button>
                                        <button type="button" class="btn btn-xs btn-outline-danger py-0.5 px-1.5">Del</button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-muted fw-bold">3</td>
                                    <td>
                                        <span class="fw-semibold text-dark">Secretary General</span>
                                        <span class="d-block text-muted small">Secretariat division</span>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">1 Winner</span></td>
                                    <td><span class="badge bg-light text-dark border">Max 1 per party</span></td>
                                    <td><span class="text-success fw-medium">Allowed</span></td>
                                    <td><span class="text-dark fw-semibold">2 Candidates</span></td>
                                    <td style="text-align: right;">
                                        <button type="button" class="btn btn-xs btn-outline-secondary py-0.5 px-1.5 me-1">Edit</button>
                                        <button type="button" class="btn btn-xs btn-outline-danger py-0.5 px-1.5">Del</button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-muted fw-bold">4</td>
                                    <td>
                                        <span class="fw-semibold text-dark">Treasurer</span>
                                        <span class="d-block text-muted small">Finance division</span>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">1 Winner</span></td>
                                    <td><span class="badge bg-light text-dark border">Max 1 per party</span></td>
                                    <td><span class="text-success fw-medium">Allowed</span></td>
                                    <td><span class="text-dark fw-semibold">2 Candidates</span></td>
                                    <td style="text-align: right;">
                                        <button type="button" class="btn btn-xs btn-outline-secondary py-0.5 px-1.5 me-1">Edit</button>
                                        <button type="button" class="btn btn-xs btn-outline-danger py-0.5 px-1.5">Del</button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-muted fw-bold">5</td>
                                    <td>
                                        <span class="fw-semibold text-dark">Auditor</span>
                                        <span class="d-block text-muted small">Auditing and inventory division</span>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">1 Winner</span></td>
                                    <td><span class="badge bg-light text-dark border">Max 1 per party</span></td>
                                    <td><span class="text-success fw-medium">Allowed</span></td>
                                    <td><span class="text-dark fw-semibold">2 Candidates</span></td>
                                    <td style="text-align: right;">
                                        <button type="button" class="btn btn-xs btn-outline-secondary py-0.5 px-1.5 me-1">Edit</button>
                                        <button type="button" class="btn btn-xs btn-outline-danger py-0.5 px-1.5">Del</button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-muted fw-bold">6</td>
                                    <td>
                                        <span class="fw-semibold text-dark">Councilors (Senators)</span>
                                        <span class="d-block text-muted small">Multi-seat legislative council</span>
                                    </td>
                                    <td><span class="badge bg-dark text-white">6 Winners</span></td>
                                    <td><span class="badge bg-dark text-white">Max 6 per party</span></td>
                                    <td><span class="text-success fw-medium">Allowed</span></td>
                                    <td><span class="text-dark fw-semibold">12 Candidates</span></td>
                                    <td style="text-align: right;">
                                        <button type="button" class="btn btn-xs btn-outline-secondary py-0.5 px-1.5 me-1">Edit</button>
                                        <button type="button" class="btn btn-xs btn-outline-danger py-0.5 px-1.5">Del</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- ============================================== -->
                <!-- TAB 3: PARTYLISTS -->
                <!-- ============================================== -->
                <div class="tab-pane fade @(activeTab == "partylists" ? "show active" : "")" id="pane-partylists" role="tabpanel">
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-3">
                        <div>
                            <h6 class="fw-bold text-dark mb-1">Registered Partylists</h6>
                            <p class="text-muted small mb-0">Partylists registered to field candidates in this election.</p>
                        </div>
                        <button type="button" class="btn btn-sm btn-dark d-inline-flex align-items-center gap-1">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            <span>Register Partylist</span>
                        </button>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="p-3.5 border rounded bg-white h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1">SANDIGAN</span>
                                        <span class="small text-muted">10 Candidates Fielded</span>
                                    </div>
                                    <h6 class="fw-bold text-dark mb-1">Sandigan Student Alliance</h6>
                                    <p class="text-muted small mb-3">Advocacy: Transparent governance and student welfare empowerment across all academic colleges.</p>
