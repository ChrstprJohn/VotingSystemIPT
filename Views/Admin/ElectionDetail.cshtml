@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Function to activate tab by key
            window.switchTab = function (tabKey) {
                const targetBtn = document.querySelector(`button[data-tab-key="${tabKey}"]`);
                if (targetBtn) {
                    const tabTrigger = new bootstrap.Tab(targetBtn);
                    tabTrigger.show();
                    // Update URL query string without page reload
                    const url = new URL(window.location);
                    url.searchParams.set('tab', tabKey);
                    window.history.replaceState({}, '', url);
                }
            };

            // Listen to tab changes to sync the URL
            const tabButtons = document.querySelectorAll('#electionDetailTabs button[data-bs-toggle="tab"]');
            tabButtons.forEach(btn => {
                btn.addEventListener('shown.bs.tab', function (e) {
                    const key = e.target.getAttribute('data-tab-key');
                    if (key) {
                        const url = new URL(window.location);
                        url.searchParams.set('tab', key);
                        window.history.replaceState({}, '', url);
                    }
                });
            });

            // On initial load, check if URL has ?tab=... or hash
            const urlParams = new URLSearchParams(window.location.search);
            const requestedTab = urlParams.get('tab') || window.location.hash.replace('#', '');
            if (requestedTab) {
                const cleanKey = requestedTab.toLowerCase().trim();
                const matchedBtn = document.querySelector(`button[data-tab-key="${cleanKey}"]`);
                if (matchedBtn) {
                    const tabTrigger = new bootstrap.Tab(matchedBtn);
                    tabTrigger.show();
                }
            }
        });
    </script>
}
