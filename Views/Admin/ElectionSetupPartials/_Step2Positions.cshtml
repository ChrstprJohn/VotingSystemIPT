@model VotingSystem.Models.ViewModels.ElectionSetupViewModel
@{
    var locked = !Model.CanEditContent;
    var positions = Model.Positions.Count > 0
        ? Model.Positions
        : new List<VotingSystem.Models.Domain.Position>
          {
              new() { Name = "President", Seats = 1, MinPerPartylist = 1, MaxPerPartylist = 1 }
          };
}

<div class="admin-card mb-4" id="step-2">
    <div class="admin-card-header d-flex align-items-center gap-2">
        <span class="badge bg-dark rounded-pill">Step 2</span>
        <span class="admin-card-title">Positions</span>
    </div>
    <div class="admin-card-body">
        <p class="text-muted small">
            <strong>Seats</strong> = how many candidates win and how many a voter may select for that position.
            Set the fewest and most candidates a party list may enter per position.
        </p>
        <form asp-action="SavePositions" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Election.Id" />
            <fieldset @(locked ? "disabled" : "")>
                @if (!locked)
                {
                    <div class="d-flex gap-2 mb-2">
                        <button type="button" id="loadDefaultPositions" class="btn btn-xs btn-outline-secondary">Load defaults</button>
                        <button type="button" id="addPositionRow" class="btn btn-xs btn-dark">Add position</button>
                    </div>
                }
                <div class="table-responsive border rounded">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Position</th>
                                <th style="width:120px;">Seats</th>
                                <th style="width:150px;">Min / party list</th>
                                <th style="width:150px;">Max / party list</th>
                                <th style="width:60px;"></th>
                            </tr>
                        </thead>
                        <tbody id="positionsBody">
                            @foreach (var p in positions)
                            {
                                <tr>
                                    <td><input type="text" name="posName" class="form-control form-control-sm" value="@p.Name" placeholder="Position name" required /></td>
                                    <td><input type="number" name="posSeats" class="form-control form-control-sm" min="1" value="@p.Seats" required /></td>
                                    <td><input type="number" name="posMin" class="form-control form-control-sm" min="0" value="@p.MinPerPartylist" required /></td>
                                    <td><input type="number" name="posMax" class="form-control form-control-sm" min="1" value="@p.MaxPerPartylist" required /></td>
                                    <td class="text-center">
                                        @if (!locked)
                                        {
                                            <button type="button" class="btn btn-xs btn-outline-danger removeRow">&times;</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </fieldset>
            @if (!locked)
            {
                <div class="mt-3 text-end">
                    <button type="submit" class="btn btn-sm btn-dark px-3">Save positions</button>
                </div>
            }
        </form>
    </div>
</div>
