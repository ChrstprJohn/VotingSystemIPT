<!-- Modal: Create New Election (2-Step Wizard) -->
<div class="modal fade import-modal" id="createElectionModal" tabindex="-1" aria-labelledby="createElectionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width: 500px;">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header border-bottom py-3 px-4">
                <h5 class="modal-title fw-bold text-dark mb-0" id="createElectionModalLabel">Create New Election</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Stepper Progress Header -->
            <div class="wizard-stepper">
                <div class="wizard-step-item active" id="wizardStepIndicator1">
                    <span class="wizard-step-badge">1</span>
                    <span class="wizard-step-label">General &amp; Schedule</span>
                </div>
                <div class="wizard-step-divider" id="wizardStepLine1">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </div>
                <div class="wizard-step-item" id="wizardStepIndicator2">
                    <span class="wizard-step-badge">2</span>
                    <span class="wizard-step-label">Ballot Positions</span>
                </div>
            </div>

            <div class="modal-body px-4 py-3.5">
                <form id="createElectionForm" onsubmit="return false;">
                    <!-- ============================================== -->
                    <!-- STEP 1: ELECTION GENERAL, DESC & SCHEDULE -->
                    <!-- ============================================== -->
                    <div id="wizardPane1" class="wizard-pane">
                        <div class="mb-3">
                            <label for="electionTitle" class="form-label small fw-semibold text-dark mb-1.5 d-inline-flex align-items-center">
                                Election Title <span class="req-star">*</span>
                            </label>
                            <input type="text" class="form-control" id="electionTitle" placeholder="e.g. Supreme Student Council General Elections" required autocomplete="off" />
                            <div class="invalid-feedback" id="electionTitleFeedback">
                                Please provide a title for the election.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="electionDesc" class="form-label small fw-semibold text-dark mb-1.5">
                                Description <span class="text-muted fw-normal">(Optional)</span>
                            </label>
                            <textarea class="form-control" id="electionDesc" rows="2" placeholder="Brief details, objectives, or instructions for voters..."></textarea>
                        </div>

                        <!-- Schedule Section -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-dark mb-1.5 d-inline-flex align-items-center">Start Schedule <span class="req-star">*</span></label>
                            <div class="row g-2">
                                <div class="col-7">
                                    <input type="date" class="form-control" id="startDate" value="2026-10-15" required />
                                </div>
                                <div class="col-5">
                                    <input type="time" class="form-control" id="startTime" value="08:00" required />
                                </div>
                            </div>
                        </div>

                        <div class="mb-1">
                            <label class="form-label small fw-semibold text-dark mb-1.5 d-inline-flex align-items-center">End Schedule <span class="req-star">*</span></label>
                            <div class="row g-2">
                                <div class="col-7">
                                    <input type="date" class="form-control" id="endDate" value="2026-10-16" required />
                                </div>
                                <div class="col-5">
                                    <input type="time" class="form-control" id="endTime" value="17:00" required />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ============================================== -->
                    <!-- STEP 2: CONFIGURE POSITIONS -->
                    <!-- ============================================== -->
                    <div id="wizardPane2" class="wizard-pane" style="display: none;">
                        <!-- Positions Column Headers -->
                        <div class="row g-2 align-items-center mb-2 px-0 text-muted" style="font-size: 0.725rem; font-weight: 600; letter-spacing: 0.3px;">
                            <div class="col ps-1">POSITION TITLE</div>
                            <div class="col-auto text-center" style="width: 85px; letter-spacing: 0.5px;">SEATS</div>
                            <div class="col-auto text-center text-nowrap" style="width: 85px; font-size: 0.7rem; letter-spacing: 0.2px;">MAX / PARTY</div>
                            <div class="col-auto" style="width: 32px;"></div>
                        </div>

                        <!-- Positions Rows Container -->
                        <div id="positionsCardsContainer" class="d-flex flex-column gap-2 mb-3">
                            <!-- Populated dynamically as compact rows -->
                        </div>

                        <!-- Add Position Button -->
                        <button type="button" class="btn-add-position-dashed w-100 d-inline-flex align-items-center justify-content-center gap-2" id="btnAddPositionCard">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            <span>Add Position</span>
                        </button>
                    </div>
                </form>
            </div>

            <!-- Modal Footer: Step 1 Controls -->
            <div class="modal-footer border-top py-3 px-4 d-flex justify-content-end" id="wizardFooterStep1">
                <button type="button" class="btn btn-dark px-4" id="btnWizardNext">
                    Next
                </button>
            </div>

            <!-- Modal Footer: Step 2 Controls -->
            <div class="modal-footer border-top py-3 px-4 d-flex justify-content-between" id="wizardFooterStep2" style="display: none !important;">
                <button type="button" class="btn btn-light border px-4" id="btnWizardBack">
                    Back
                </button>
                <button type="button" class="btn btn-dark px-4" id="btnWizardSubmit">
                    Create Election
                </button>
            </div>
        </div>
    </div>
</div>
