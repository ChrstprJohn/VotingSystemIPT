<!-- Modal: Add Position -->
<div class="modal fade import-modal" id="addPositionModal" tabindex="-1" aria-labelledby="addPositionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-bottom pb-3">
                <div>
                    <h5 class="modal-title fw-bold text-dark" id="addPositionModalLabel">Add Position to Election</h5>
                    <p class="text-muted small mb-0">Define the position title, winners quota, and partylist limits.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body py-3">
                <form id="addPositionForm">
                    <!-- Position Title -->
                    <div class="mb-3">
                        <label for="posTitle" class="form-label small fw-semibold text-dark">
                            Position Name <span class="text-danger">*</span>
                        </label>
                        <input type="text" class="form-control" id="posTitle" placeholder="e.g. President, Vice President, Councilor" required />
                    </div>

                    <!-- Description / Scope -->
                    <div class="mb-3">
                        <label for="posDescription" class="form-label small fw-semibold text-dark">
                            Position Description / Note <span class="text-muted fw-normal">(Optional)</span>
                        </label>
                        <input type="text" class="form-control" id="posDescription" placeholder="e.g. Executive branch head" />
                    </div>

                    <!-- Winners & Partylist Limits Row -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label for="posWinners" class="form-label small fw-semibold text-dark">
                                Seats / Winners Count <span class="text-danger">*</span>
                            </label>
                            <input type="number" class="form-control" id="posWinners" value="1" min="1" max="50" required />
                            <div class="form-text small text-muted">
                                E.g., <code>1</code> for President, <code>6</code> for Councilors.
                            </div>
                        </div>
                        <div class="col-6">
                            <label for="posMaxParty" class="form-label small fw-semibold text-dark">
                                Max per Partylist <span class="text-danger">*</span>
                            </label>
                            <input type="number" class="form-control" id="posMaxParty" value="1" min="1" max="50" required />
                            <div class="form-text small text-muted">
                                Prevents a party from fielding too many candidates.
                            </div>
                        </div>
                    </div>

                    <!-- Ballot Display Order & Options -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label for="posOrder" class="form-label small fw-semibold text-dark">
                                Ballot Display Order
                            </label>
                            <input type="number" class="form-control" id="posOrder" value="1" min="1" />
                            <div class="form-text small text-muted">
                                Sequence on the ballot (1 = first).
                            </div>
                        </div>
                        <div class="col-6 d-flex align-items-center pt-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="posAllowAbstain" checked />
                                <label class="form-check-label small fw-medium text-dark" for="posAllowAbstain">
                                    Allow Abstain / Pass
                                </label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer border-top pt-3">
                <button type="button" class="btn btn-sm btn-light border" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm btn-dark px-3" data-bs-dismiss="modal">
                    Save Position
                </button>
            </div>
        </div>
    </div>
</div>
