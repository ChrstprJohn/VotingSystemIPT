<!-- Modal: Import from Registrar File -->
<div class="modal fade import-modal" id="importRegistrarModal" tabindex="-1" aria-labelledby="importRegistrarModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="importRegistrarModalLabel">Import Registrar Masterlist</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-2">
                <p class="text-muted small mb-3">
                    Upload the official masterlist exported from the Registrar Office. The system will automatically map the students and set their voting eligibility based on their enrollment status.
                </p>

                <!-- Drag and drop zone -->
                <div class="import-dropzone" onclick="document.getElementById('registrarFileInput').click()">
                    <input type="file" id="registrarFileInput" accept=".csv, .xlsx, .xls" style="display: none;" />
                    <div class="import-dropzone-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="17 8 12 3 7 8"></polyline>
                            <line x1="12" y1="3" x2="12" y2="15"></line>
                        </svg>
                    </div>
                    <div class="fw-semibold text-dark">Click to browse or drop registrar file here</div>
                    <div class="text-muted small mt-1">Supports CSV or Excel (.xlsx, .xls)</div>
                </div>

                <!-- Expected file format guidance -->
                <div class="mt-3 p-2 bg-light rounded border">
                    <div class="text-muted small fw-semibold mb-1">Required File Columns:</div>
                    <div>
                        <span class="import-field-tag">student_id</span>
                        <span class="import-field-tag">fname</span>
                        <span class="import-field-tag">lname</span>
                        <span class="import-field-tag">middle</span>
                        <span class="import-field-tag">suffix</span>
                        <span class="import-field-tag">status</span>
                        <span class="import-field-tag">email</span>
                    </div>
                </div>

                <div class="alert alert-light border small text-muted mt-3 mb-0">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1 text-primary">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="16" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                    </svg>
                    <strong>Automatic Eligibility:</strong> Rows with status <code>Active</code> are automatically marked <strong>Eligible</strong> to vote. <code>Inactive</code> rows are marked <strong>Ineligible</strong>.
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-sm btn-light border" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm btn-dark px-3" id="btnConfirmImport" data-bs-dismiss="modal">
                    Upload & Sync Voters
                </button>
            </div>
        </div>
    </div>
</div>
