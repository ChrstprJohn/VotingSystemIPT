@model List<VotingSystem.Models.Domain.Election>
@{
    ViewData["Title"] = "Voters";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin.css" asp-append-version="true" />
}

<div class="admin-card">
    <div class="admin-card-header"><span class="admin-card-title">Voter data by election</span></div>
    <div class="admin-card-body">
        <p class="text-muted small">
            Voter populations are managed per election. Open an election's setup to add or replace
            department/course CSV files.
        </p>
        <div class="table-responsive border rounded">
            <table class="admin-table mb-0">
                <thead>
                    <tr><th>Election</th><th>Status</th><th style="width:160px;"></th></tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="3" class="text-center text-muted py-3">No elections yet.</td></tr>
                    }
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@e.Title</td>
                            <td class="text-muted">@e.StatusAt(DateTime.UtcNow)</td>
                            <td>
                                <a class="btn btn-xs btn-outline-secondary"
                                   asp-action="ElectionSetup" asp-route-id="@e.Id">Manage voters</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
