<!-- Modal: Register New Partylist -->
<div class="modal fade import-modal" id="addPartylistModal" tabindex="-1" aria-labelledby="addPartylistModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header border-bottom pb-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="election-workspace-avatar">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path>
                            <line x1="4" y1="22" x2="4" y2="15"></line>
                        </svg>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="addPartylistModalLabel">Register New Partylist</h5>
                        <p class="text-muted small mb-0">Add a partylist and its platform to make it available for candidate filing.</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <form id="addPartylistForm">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label for="partylistName" class="form-label small fw-semibold text-dark">
                                Partylist Name <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control form-control-sm" id="partylistName" placeholder="e.g. Kabalikat Coalition" required />
                        </div>

                        <div class="col-md-4">
                            <label for="partylistAbbreviation" class="form-label small fw-semibold text-dark">
                                Abbreviation <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control form-control-sm text-uppercase" id="partylistAbbreviation" placeholder="e.g. KBC" maxlength="8" required />
                        </div>

                        <div class="col-md-4">
                            <label for="partylistColor" class="form-label small fw-semibold text-dark">
                                Party Color <span class="text-danger">*</span>
                            </label>
                            <div class="d-flex align-items-center gap-2">
                                <input type="color" class="form-control form-control-sm form-control-color" id="partylistColor" value="#2C3E50" title="Choose party color" />
                                <input type="text" class="form-control form-control-sm" id="partylistColorHex" value="#2C3E50" readonly />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label for="partylistStatus" class="form-label small fw-semibold text-dark">
                                Status <span class="text-danger">*</span>
                            </label>
                            <select class="form-select form-select-sm" id="partylistStatus">
                                <option value="active" selected>🟢 Active</option>
                                <option value="inactive">⚪ Inactive</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label for="partylistDateRegistered" class="form-label small fw-semibold text-dark">
                                Date Registered
                            </label>
                            <input type="date" class="form-control form-control-sm" id="partylistDateRegistered" />
                        </div>

                        <div class="col-12">
                            <label for="partylistPlatform" class="form-label small fw-semibold text-dark">
                                Platform / Slogan <span class="text-muted fw-normal">(Optional)</span>
                            </label>
                            <textarea class="form-control form-control-sm" id="partylistPlatform" rows="3" placeholder="e.g. Unity in service, strength in diversity."></textarea>
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-semibold text-dark">
                                Party Logo <span class="text-muted fw-normal">(Optional)</span>
                            </label>
                            <div class="import-dropzone" onclick="document.getElementById('partylistLogoInput').click()">
                                <input type="file" id="partylistLogoInput" accept=".png, .jpg, .jpeg, .svg" style="display: none;" />
                                <div class="import-dropzone-icon">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                        <polyline points="17 8 12 3 7 8"></polyline>
                                        <line x1="12" y1="3" x2="12" y2="15"></line>
                                    </svg>
                                </div>
                                <div class="fw-semibold text-dark">Click to browse or drop a logo file here</div>
                                <div class="text-muted small mt-1">Supports PNG, JPG or SVG</div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer border-top pt-3">
                <button type="button" class="btn btn-sm btn-light border" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm btn-dark px-3 fw-medium" id="btnConfirmAddPartylist" data-bs-dismiss="modal">
                    Register Partylist
                </button>
            </div>
        </div>
    </div>
</div>
