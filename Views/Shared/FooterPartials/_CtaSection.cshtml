@* "Ready to Participate?" CTA — sits above the Contact section in the global footer.
   Uses the dark .contact-card shell so it matches the Contact section's treatment. *@
<div id="cta" class="site-footer-cta">
    <div class="container">
        <div class="contact-card">
            <div class="contact-card-body footer-cta-inner">
                <div>
                    <span class="footer-cta-eyebrow">
                        <span class="status-indicator-pulse live"></span>
                        Ready When You Are
                    </span>
                    <h2 class="footer-cta-title">Ready to Participate?</h2>
                    <p class="footer-cta-text">
                        Sign in to check ongoing elections, review candidate platforms, and submit your vote.
                    </p>
                </div>

                <a asp-controller="Account" asp-action="Login" class="footer-cta-button">
                    <span class="footer-cta-button-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 11l3 3L22 4"></path>
                            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                        </svg>
                    </span>
                    <span class="footer-cta-button-text">
                        <strong>Get Started</strong>
                        <small>Sign in &amp; cast your vote</small>
                    </span>
                    <svg class="footer-cta-button-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </a>
            </div>
        </div>
    </div>
</div>
