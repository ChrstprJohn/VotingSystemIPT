<div id="contact" class="site-footer-contact">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="contact-section-title">Contact Us</h2>
            <p class="contact-section-subtitle">Have a question about the election process or your account? Reach out and the Student Affairs Office will get back to you.</p>
        </div>

        <div class="row g-4">
            <div class="col-lg-5">
                <div class="contact-card h-100">
                    <div class="contact-card-header">
                        <h4 class="contact-card-title">Get in Touch</h4>
                    </div>
                    <div class="contact-card-body d-flex flex-column gap-4">
                        <div class="contact-info-item">
                            <span class="contact-info-icon">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                    <polyline points="22 6 12 13 2 6"></polyline>
                                </svg>
                            </span>
                            <div>
                                <div class="contact-info-label">Email</div>
                                <div class="contact-info-value">qcu.example.email@edu.qcu.ph</div>
                            </div>
                        </div>

                        <div class="contact-info-item">
                            <span class="contact-info-icon">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>
                                </svg>
                            </span>
                            <div>
                                <div class="contact-info-label">Phone</div>
                                <div class="contact-info-value">(02) 8123-4567</div>
                            </div>
                        </div>

                        <div class="contact-info-item">
                            <span class="contact-info-icon">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                    <circle cx="12" cy="10" r="3"></circle>
                                </svg>
                            </span>
                            <div>
                                <div class="contact-info-label">Office</div>
                                <div class="contact-info-value">Student Affairs Office, Quezon City University</div>
                            </div>
                        </div>

                        <div class="contact-info-item">
                            <span class="contact-info-icon">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                </svg>
                            </span>
                            <div>
                                <div class="contact-info-label">Office Hours</div>
                                <div class="contact-info-value">Monday – Friday, 8:00 AM – 5:00 PM</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="contact-card h-100">
                    <div class="contact-card-header">
                        <h4 class="contact-card-title">Send a Message</h4>
                    </div>
                    <div class="contact-card-body">
                        <form id="contactForm" novalidate>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="contactName" class="form-label small fw-semibold contact-form-label">
                                        Full Name <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control form-control-sm" id="contactName" placeholder="Juan Dela Cruz" required />
                                </div>

                                <div class="col-md-6">
                                    <label for="contactEmail" class="form-label small fw-semibold contact-form-label">
                                        Email Address <span class="text-danger">*</span>
                                    </label>
                                    <input type="email" class="form-control form-control-sm" id="contactEmail" placeholder="juan.delacruz@qcu.edu.ph" required />
                                </div>

                                <div class="col-12">
                                    <label for="contactSubject" class="form-label small fw-semibold contact-form-label">
                                        Subject <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control form-control-sm" id="contactSubject" placeholder="e.g. Issue casting my vote" required />
                                </div>

                                <div class="col-12">
                                    <label for="contactMessage" class="form-label small fw-semibold contact-form-label">
                                        Message <span class="text-danger">*</span>
                                    </label>
                                    <textarea class="form-control form-control-sm" id="contactMessage" rows="5" placeholder="Tell us more about your concern..." required></textarea>
                                </div>

                                <div class="col-12" id="contactFormSuccess" hidden>
                                    <div class="contact-form-success">
                                        Thanks! Your message has been noted — the Student Affairs Office will get back to you shortly.
                                    </div>
                                </div>

                                <div class="col-12 d-flex justify-content-end">
                                    <button type="submit" class="btn btn-sm btn-light px-3 fw-medium d-inline-flex align-items-center gap-1">
                                        <span>Send Message</span>
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="22" y1="2" x2="11" y2="13"></line>
                                            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const form = document.getElementById('contactForm');
        const successBox = document.getElementById('contactFormSuccess');

        if (form) {
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                if (!form.checkValidity()) {
                    form.reportValidity();
                    return;
                }
                if (successBox) successBox.hidden = false;
                form.reset();
            });
        }
    });
</script>
